<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aladdin"
            android:textColor="@color/gold"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="⚙  Sozlamalar"
            android:textColor="#CCFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#33F5B700"
        android:padding="12dp"
        android:text="Telegram va WhatsApp xabarlarini o'qish uchun shu yerni bosib, Aladdin'ga bildirishnomalarga ruxsat bering"
        android:textColor="@color/gold"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#99FFFFFF"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salom! «Привет Аладин» deng yoki tugmani bosing. Buyruq oxirida «тезда» desangiz, darhol bajaraman: «Санжарга телефон қил тезда», «Telegram xabarlarini o'qi tezda»."
            android:textColor="#FFFFFF"
            android:textSize="24sp" />
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <TextView
            android:id="@+id/talk"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_talk"
            android:backgroundTint="#2E7D32"
            android:elevation="8dp"
            android:gravity="center"
            android:text="GAPIRISH"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
